	(text "2 x 4-20 mA inputs: 100R shunt to GND_F, so 20 mA = 2.0 V at the ADC. Terminals: AI1, M, AI2, M, AO, M."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
